  {
    "type": "checkbox",
    "label": "New tabs open a blank page instead of Zen's new tab page",
    "property": "zia.features.blank-newtab",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Search field at the top of the sidebar",
    "property": "zia.features.sidebar-search",
    "defaultValue": true
