[
  {
    "type": "separator",
    "label": "Features"
  },
  {
    "type": "checkbox",
    "label": "Music player card",
    "property": "zia.features.media-player",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Find in page bar",
    "property": "zia.features.find-bar",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Icon picker (1,512 Phosphor icons)",
    "property": "zia.features.icon-picker",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Undo a closed tab with Cmd/Ctrl+Z",
    "property": "zia.features.undo-close",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Suggest a folder's icon with a local model (downloads ~25MB the first time)",
    "property": "zia.features.folder-icon-suggest",
    "defaultValue": false
  },
  {
    "type": "checkbox",
    "label": "Collapse all folders when Zen starts",
    "property": "zia.features.fold-on-start",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Show the sidebar collapse button in the top toolbar",
    "property": "zia.features.collapse-in-urlbar",
    "defaultValue": true
  },
  {
    "type": "checkbox",
    "label": "Always align the expanded address bar to the left (not just on click)",
    "property": "zia.features.urlbar-align",
    "defaultValue": true
