  {
    "type": "checkbox",
    "label": "Open the search overlay automatically on a new tab",
    "property": "zia.features.newtab-search",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "New tabs"
  },
  {
    "type": "checkbox",
    "label": "New tabs open your default search engine's page (off = Zen's floating address bar)",
    "property": "zia.newtab.search-engine",
    "defaultValue": false
  },
  {
    "type": "separator",
    "label": "Folders"
  },
  {
    "type": "checkbox",
    "label": "Tiny bounce when folders open or close",
